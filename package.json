{
  "name": "tacsuite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TacSuite - portage TypeScript de PC-Tac et du Generateur d'OI (GStart-main)",
  "scripts": {
    "dev": "vite --port 9678 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "node tests/visual/compare.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gen:pdf-fonts": "node scripts/gen-pdf-fonts.mjs",
    "test:pdf": "node tests/pdf/verify-structure.mjs",
    "doctor": "npx react-doctor@latest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:pdf"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "html2canvas": "1.4.1",
    "jszip": "3.10.1",
    "maplibre-gl": "4.7.1",
    "material-symbols": "0.45.10",
    "pdf-lib": "1.17.1",
    "pdfmake": "0.3.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/pdfmake": "0.3.3",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react-doctor": "^0.9.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
